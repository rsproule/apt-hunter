// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scrape {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Echo user who initiated this scrape
  userId String

  // Scrape metadata
  name        String? // Optional user-provided name
  searchType  String // "zipcode" or "url"
  searchQuery Json // Store the search parameters as JSON

  // Apify run info
  apifyRunId String  @unique
  taskId     String? // Trigger.dev task ID

  // Status tracking
  status      String // "pending", "running", "completed", "failed"
  error       String?
  completedAt DateTime?
  durationMs  Int? // Duration in milliseconds

  // Results summary
  listingsCount Int @default(0)

  // Relations
  listings       ScrapeListing[]
  enhancements   Enhancement[]
  configurations SearchConfiguration[]

  @@index([userId])
  @@index([createdAt])
  @@index([apifyRunId])
  @@index([status])
}

model Listing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Zillow identifiers
  zpid      String @unique
  detailUrl String

  // Images
  imgSrc     String?
  photos     String[] // Array of photo URLs from carousel
  hasImage   Boolean  @default(false)
  has3DModel Boolean  @default(false)
  hasVideo   Boolean  @default(false)

  // Status
  statusType String // FOR_SALE, FOR_RENT, etc.
  statusText String

  // Pricing
  price          Int // Unformatted price in dollars
  priceFormatted String? // "$995,000" format
  currency       String  @default("USD")

  // Location
  address        String
  addressStreet  String?
  addressCity    String?
  addressState   String?
  addressZipcode String?
  latitude       Float?
  longitude      Float?

  // Property details
  beds     Int?
  baths    Float?
  area     Int? // Square footage
  homeType String? // CONDO, APARTMENT, HOUSE, etc.

  // Dates
  availabilityDate DateTime?
  scrapedAt        DateTime  @default(now())

  // Broker info
  brokerName String?

  // Estimates
  zestimate     Int?
  rentZestimate Int?

  // Flags
  isFeaturedListing Boolean @default(false)

  // Store full raw JSON for reference
  rawData Json

  // Relations
  scrapes            ScrapeListing[]
  enhancementResults EnhancementResult[]
  userResponses      UserListingResponse[]

  @@index([zpid])
  @@index([addressZipcode])
  @@index([addressCity, addressState])
  @@index([price])
  @@index([beds, baths])
  @@index([statusType])
  @@index([scrapedAt])
}

// Junction table connecting Scrapes to Listings
model ScrapeListing {
  scrape    Scrape  @relation(fields: [scrapeId], references: [id], onDelete: Cascade)
  scrapeId  String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  // When this listing was found in this scrape
  foundAt DateTime @default(now())

  @@id([scrapeId, listingId])
  @@index([scrapeId])
  @@index([listingId])
}

// Semantic enhancement query session
model Enhancement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Link to the scrape being enhanced
  scrape   Scrape @relation(fields: [scrapeId], references: [id], onDelete: Cascade)
  scrapeId String

  // Echo user who created this enhancement
  userId String

  // User's query text
  query String

  // Trigger.dev task ID
  taskId String?

  // Status tracking
  status      String // "pending", "processing", "completed", "failed"
  error       String?
  completedAt DateTime?

  // Progress tracking
  processedCount Int @default(0)
  totalCount     Int @default(0)

  // Relations
  columns        EnhancementColumn[]
  results        EnhancementResult[]
  configurations SearchConfiguration[]

  @@index([scrapeId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Semantic columns generated from the enhancement query
model EnhancementColumn {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Link to enhancement
  enhancement   Enhancement @relation(fields: [enhancementId], references: [id], onDelete: Cascade)
  enhancementId String

  // Column definition
  name        String // e.g., "has_hardwood_floors", "modern_kitchen_score"
  type        String // "boolean" or "score"
  description String // Human-readable description

  // User-configurable weight (0-10) for composite scoring
  // Higher weight = more important to you
  // 0 = don't care, 10 = very important
  weight Int @default(5)

  // Display order
  order Int @default(0)

  // Relations
  values EnhancementValue[]

  @@index([enhancementId])
}

// AI-analyzed values for each listing in an enhancement
model EnhancementResult {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Links to enhancement and listing
  enhancement   Enhancement @relation(fields: [enhancementId], references: [id], onDelete: Cascade)
  enhancementId String
  listing       Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId     String

  // Column values stored as JSON (for backwards compatibility and display)
  // Structure: { "has_hardwood_floors": true, "modern_kitchen_score": 8, ... }
  values Json

  // Composite score calculated from weighted column values
  compositeScore Float @default(0)

  // Processing status
  status String  @default("pending") // "pending", "processing", "completed", "failed"
  error  String?

  // Relations
  individualValues EnhancementValue[]

  @@unique([enhancementId, listingId])
  @@index([enhancementId])
  @@index([listingId])
  @@index([status])
  @@index([enhancementId, compositeScore])
}

// Individual column values for efficient sorting and indexing
model EnhancementValue {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Links
  result        EnhancementResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  resultId      String
  column        EnhancementColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  columnId      String
  enhancementId String
  listingId     String

  // Normalized value (boolean as 0 or 10, scores as 0-10)
  normalizedValue Float

  @@unique([resultId, columnId])
  @@index([enhancementId, columnId, normalizedValue]) // For efficient sorting by any column
  @@index([listingId, columnId])
}

// Search configuration - the user-facing "search" concept
// Combines a scrape (data), enhancement (AI analysis), and preferences (weights)
model SearchConfiguration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Echo user who owns this configuration
  userId String

  // Configuration metadata
  name        String? // Optional user-provided name
  description String? // Optional description

  // Link to the scrape (data source)
  scrape   Scrape @relation(fields: [scrapeId], references: [id], onDelete: Cascade)
  scrapeId String

  // Link to the enhancement (AI analysis)
  enhancement   Enhancement @relation(fields: [enhancementId], references: [id], onDelete: Cascade)
  enhancementId String

  // Column weights stored as JSON
  // Structure: { "columnName1": 5.0, "columnName2": 8.5, ... }
  columnWeights Json @default("{}")

  // Relations
  userResponses UserListingResponse[]

  @@index([userId])
  @@index([scrapeId])
  @@index([enhancementId])
  @@index([createdAt])
}

// User's response to a listing (like/dislike/pass)
model UserListingResponse {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User who made the response
  userId String

  // Which search configuration this response is for
  configuration   SearchConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  configurationId String

  // Which listing was responded to
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  // Response: "like", "dislike", or "pass"
  response String

  // Optional notes
  notes String?

  @@unique([configurationId, listingId]) // One response per listing per configuration
  @@index([userId])
  @@index([configurationId])
  @@index([listingId])
  @@index([userId, response]) // Efficiently find all user's liked/disliked across configs
  @@index([configurationId, response]) // Efficiently find liked/disliked for a config
}
